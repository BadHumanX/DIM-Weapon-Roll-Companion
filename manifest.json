{
  "manifest_version": 3,
  "name": "DIM Weapon Roll Companion",
  "version": "0.1.0",
  "description": "Injects a green rectangle under weapon cards in DIM.",
  "permissions": [],
  "host_permissions": [
    "https://app.destinyitemmanager.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://app.destinyitemmanager.com/*"],
      "js": [
        "constants.js",
        "selectors.js",
        "style.js",
        "inject.js",
        "observer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["Asset/skull.png"],
      "matches": ["https://app.destinyitemmanager.com/*"]
    }
  ]
}
